{
  "App": {
    "Name": "Dependency Service",
    "Debug": true,
    "Mode": "dev",
    "GRPCPort": "50051",
    "RESTPort": "40051"
  },
  "Telemetry": {
    "Enabled": true,
    "OltpExporter": "0.0.0.0:4317"
  },
  "Database": {
    "Driver": "duckdb",
    "Path": "/var/lib/scanoss/serving.duckdb",
    "Trace": false
  },
  "TLS": {
    "CertFile": "",
    "KeyFile": ""
  },
  "Filtering": {
    "AllowListFile": "",
    "DenyListFile": "",
    "BlockByDefault": false,
    "TrustProxy": false
  },
  "TransitiveResources": {
    "MaxWorkers": 10,
    "MaxQueueSize": 20000,
    "DefaultResponseSize": 1000,
    "MaxResponseSize": 5000,
    "Timeout": 600,
    "MaxDepth": 10,
    "DefaultDepth": 3
  }
}
